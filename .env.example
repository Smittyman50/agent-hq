# Copy to .env and fill in. The same file works for the API process and every worker.

# --- Shared infrastructure (deploy/infra) ---
AHQ_DB_URL=postgresql://agent_hq:change-me@infra-host:5432/agent_hq
AHQ_REDIS_URL=redis://:change-me@infra-host:6379/0
# MQTT bridge (API process only). Leave empty to disable. mqtts:// for TLS.
AHQ_MQTT_URL=mqtt://agent-hq:change-me@infra-host:1883

# --- Models ---
# Model providers (Ollama servers, OpenAI, Anthropic, OpenAI-compatible) are set up on
# the Models page in the UI. Their API keys can be stored there, or left blank there and
# supplied here instead (workers read these when a provider has no stored key):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tracing: OTLP to your Collector, which forwards to Phoenix ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://perceptor:4318
OTEL_SERVICE_NAME=agent-hq

# --- Tuning (defaults shown) ---
# AHQ_MAX_DELEGATION_DEPTH=4
# AHQ_DELEGATE_WAIT_TIMEOUT=1800   # seconds before a waiting delegation goes background
# AHQ_CLAIM_IDLE_MS=60000          # how long before a dead worker's job is reclaimed
# AHQ_WORKER_HEARTBEAT=15          # seconds between job heartbeats
# AHQ_MAX_ATTEMPTS=3               # retries of a job whose worker keeps dying
# AHQ_EMBED_WORKER=0               # 1 = also run a worker inside the API process
