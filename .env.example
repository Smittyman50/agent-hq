# Copy to .env and fill in. The same file works for the API process and every worker.

# --- Shared infrastructure (deploy/infra) ---
AHQ_DB_URL=postgresql://agent_hq:change-me@infra-host:5432/agent_hq
AHQ_REDIS_URL=redis://:change-me@infra-host:6379/0
# MQTT bridge (API process only). Leave empty to disable. mqtts:// for TLS.
AHQ_MQTT_URL=mqtt://agent-hq:change-me@infra-host:1883
# Notifications for you (sub-agent requests and decisions) go to this topic on the same broker.
# AHQ_MQTT_NOTIFY_TOPIC=agent-hq/notifications
# The web UI's address, for links in notifications.
# AHQ_PUBLIC_URL=https://shockwave.home.arpa
# Scheduled agent tasks are run by the API process; set to 0 to turn that off here.
# AHQ_SCHEDULER=1

# --- HTTPS and sign-in (deploy/caddy; see the README's "Sign-in and HTTPS") ---
# The name you browse to; Caddy gets its certificate from your step-ca's ACME provisioner.
AHQ_SITE=shockwave.home.arpa
ACME_CA=https://ca.home.arpa/acme/acme/directory
# ACME_EMAIL=you@example.com
# Plain HTTP on 8000 is for this host only unless you set this (e.g. 8000) while getting
# HTTPS going. Agents and workers don't use it.
# AHQ_HTTP_BIND=127.0.0.1:8000
# A tool call that needs your approval waits this long for a decision, then isn't made.
# AHQ_APPROVAL_TIMEOUT_MINUTES=30
# Sessions end after this many days without use, and after the maximum in any case.
# AHQ_SESSION_IDLE_DAYS=7
# AHQ_SESSION_MAX_DAYS=30

# --- Models ---
# Model providers (Ollama servers, OpenAI, Anthropic, OpenAI-compatible) are set up on
# the Models page in the UI. Their API keys can be stored there, or left blank there and
# supplied here instead (workers read these when a provider has no stored key):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tracing: OTLP to your Collector, which forwards to Phoenix ---
# (OTLP over HTTP: the Collector needs its http receiver on 4318. Or point straight at
#  Phoenix: http://phoenix-host:6006)
OTEL_EXPORTER_OTLP_ENDPOINT=http://perceptor:4318
OTEL_SERVICE_NAME=agent-hq
# Keep the MCP libraries' own protocol spans (MCP send tools/call…, server/discover…).
# Off by default: they show as "unknown" in Phoenix and repeat the execute_tool spans.
# AHQ_TRACE_MCP=0
# Phoenix project for the traces (defaults to OTEL_SERVICE_NAME; without one Phoenix uses "default")
# PHOENIX_PROJECT_NAME=agent-hq
# 0 = keep prompts and replies out of traces (screenshots are always left out)
# AHQ_TRACE_CONTENT=1

# --- Tuning (defaults shown) ---
# AHQ_MAX_DELEGATION_DEPTH=4
# AHQ_DELEGATE_WAIT_TIMEOUT=1800   # seconds before a waiting delegation goes background
# AHQ_CLAIM_IDLE_MS=60000          # how long before a dead worker's job is reclaimed
# AHQ_WORKER_HEARTBEAT=15          # seconds between job heartbeats
# AHQ_MAX_ATTEMPTS=3               # retries of a job whose worker keeps dying
# AHQ_HANDOFF_TIMEOUT=1800         # how long an agent waits for you to take over its desktop
# AHQ_ATTACHMENT_MAX_BYTES=26214400 # largest chat attachment (25 MB)
# AHQ_ATTACHMENT_MAX_FILES=10      # most files on one message
# AHQ_EMBED_WORKER=0               # 1 = also run a worker inside the API process
# Worker names in Docker default to <prefix>-<host>-<last 4 of container ID>, e.g.
# worker-shockwave-7090. The host comes from the mounted /etc/hostname; set it here where
# that file doesn't exist (Docker Desktop). AHQ_WORKER_NAME sets a fixed name instead.
# AHQ_HOST_NAME=shockwave

# --- Web reader (text-only web tools for agents) ---
# Your SearXNG for the search_web tool (see deploy/searxng). Leave empty to go without search.
SEARXNG_URL=
# The reader refuses LAN/private addresses unless listed here (comma-separated host names).
# WEBREADER_ALLOW_HOSTS=wiki.home.arpa,docs.home.arpa
