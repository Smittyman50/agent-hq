# Copy to .env and fill in what you use.

# Ollama (OpenAI-compatible endpoint) for "ollama:<model>" agents
AHQ_OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Hosted models for "openai:<model>" / "anthropic:<model>" agents
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tracing: send OTLP to your Collector, which forwards to Phoenix
OTEL_EXPORTER_OTLP_ENDPOINT=http://perceptor:4318
OTEL_SERVICE_NAME=agent-hq

# Max nesting of delegations (A -> B -> C ...)
AHQ_MAX_DELEGATION_DEPTH=4
