# Credentials for ONE lab tools instance: copy to deploy/lab/<instance>.env (e.g.
# lab-network.env) and keep only what its integrations need. Give a read instance
# read-only credentials and a write instance its own narrow write credentials: the same
# variable names, different files (docs/labtools.md, "Credentials").

# mikrotik
MIKROTIK_USER=
MIKROTIK_PASSWORD=
# snmp (v2c community, or the v3 user)
SNMP_COMMUNITY=
SNMP_USER=
SNMP_AUTH_KEY=
SNMP_PRIV_KEY=
# dns (Technitium API token)
TECHNITIUM_TOKEN=
# dhcp (Kea Control Agent basic auth, if enabled)
KEA_USER=
KEA_PASSWORD=
# proxmox: user@realm!tokenid=secret
PROXMOX_TOKEN=
# truenas
TRUENAS_API_KEY=
# zabbix
ZABBIX_TOKEN=
# prometheus (optional bearer tokens)
PROMETHEUS_TOKEN=
ALERTMANAGER_TOKEN=
# graylog (access token)
GRAYLOG_TOKEN=
# ssh: the key files are mounted from deploy/lab/ssh; optional default user
# LABTOOLS_SSH_USER=agent-hq
